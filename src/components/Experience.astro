---

<section id="experiencia" class="experience scroll-mt-32">
  <div class="experience-inner">
    <h2 class="section-title">Experiencia Laboral</h2>

    <div class="experience-panel" data-experience>
      <div class="job-list" role="tablist" aria-label="Experiencia laboral">
        {
          jobs.map((job, index) => (
            <button
              type="button"
              class:list={["job-tab", index === 0 && "is-active"]}
              role="tab"
              id={`tab-${job.id}`}
              data-job-tab={job.id}
              aria-selected={index === 0 ? "true" : "false"}
              aria-controls={`panel-${job.id}`}
            >
              <span class="job-node" aria-hidden="true"></span>
              <span class:list={["job-tab-icon", job.tone]} aria-hidden="true">
                <i class={job.icon} />
              </span>
              <span class="job-tab-body">
                <span class="job-tab-top">
                  <span class="job-tab-company">{job.company}</span>
                  {job.markType === "badge" ? (
                    <span class="job-badge">{job.mark}</span>
                  ) : (
                    <span class="job-duration">{job.mark}</span>
                  )}
                </span>
                <span class="job-tab-role">{job.role}</span>
                <span class="job-tab-dates">{job.dates}</span>
              </span>
            </button>
          ))
        }
      </div>

      <div class="job-detail">
        {
          jobs.map((job, index) => (
            <article
              class:list={["job-panel", index === 0 && "is-active"]}
              id={`panel-${job.id}`}
              role="tabpanel"
              data-job-panel={job.id}
              aria-labelledby={`tab-${job.id}`}
            >
              <div class="job-head">
                <p class="job-when">{job.detailDates}</p>
                {job.markType === "badge" && <span class="job-badge">{job.mark}</span>}
              </div>
              <h3 class="job-role">{job.role}</h3>
              <p class="job-company">{job.companyLabel}</p>
              <ul class="job-duties">
                {job.duties.map((duty) => (
                  <li>{duty}</li>
                ))}
              </ul>
              <ul class="job-tools">
                {job.tools.map((tool) => (
                  <li class="skill-pill">{tool}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector("[data-experience]");
  if (root) {
    const tabs = root.querySelectorAll("[data-job-tab]");
    const panels = root.querySelectorAll("[data-job-panel]");

    const activate = (id: string) => {
      tabs.forEach((tab) => {
        const selected = tab.getAttribute("data-job-tab") === id;
        tab.classList.toggle("is-active", selected);
        tab.setAttribute("aria-selected", String(selected));
      });
      panels.forEach((panel) => {
        panel.classList.toggle("is-active", panel.getAttribute("data-job-panel") === id);
      });
    };

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const id = tab.getAttribute("data-job-tab");
        if (id) activate(id);
      });
    });
  }
</script>
