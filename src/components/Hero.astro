---
import { publicUrl } from "../lib/publicUrl";
---

<section id="inicio" class="hero scroll-mt-12">
  <div class="hero-grid">
    <div class="hero-copy">
      <h1 class="hero-title">Nataly Bernal</h1>
      <p class="hero-role">
        Web &amp; <span class="hero-role-accent">UX/UI Designer</span>
      </p>
      <p class="hero-text">
       Diseño UX/UI de interfaces en Figma, creación de recursos gráficos, maquetación front-end de sitios web y landing pages con HTML, CSS y Tailwind CSS, integrando herramientas de IA para un flujo de trabajo moderno y eficiente.
      </p>

      <div class="hero-actions">
        <a href="#proyectos" class="btn-projects">
          Ver Proyectos
          <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
        </a>
        <a href="https://wa.me/573017160229" class="btn-talk" target="_blank" rel="noreferrer">
          Hablemos
          <i class="fa-regular fa-comment" aria-hidden="true"></i>
        </a>
      </div>
    </div>

    <div class="hero-photo">
      <div class="hero-frame">
        <img
          src={publicUrl("/profile.jpg")}
          alt="Nataly Bernal, web designer y UX/UI designer"
          class="hero-image"
        />
      </div>

      <p class="experience-badge">
        <span class="experience-icon" aria-hidden="true">
          <i class="fa-solid fa-bullseye"></i>
        </span>
        +5 años de experiencia
      </p>
    </div>
  </div>
</section>
